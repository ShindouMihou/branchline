{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchline",
  "version": "0.4.6",
  "identifier": "dev.branchline.git",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Branchline",
        "width": 1280,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; worker-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMEQzMkQyMTBDRDkzRTUKUldUbGs4MFEwaklOa01HeVd2bnFZU0h4R0xZSzJNWmMvNGNLbXZTQlV4V0x0TmxkZ0ZmVzROVDcK",
      "endpoints": [
        "https://github.com/ShindouMihou/branchline/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
